{
  "name": "viam-pipeline-debugger",
  "version": "1.0.0",
  "description": "General-purpose visual debugging tool for Viam component pipelines",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "viam",
    "robotics",
    "debugging",
    "pipeline",
    "vision",
    "camera",
    "point-cloud"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@viamrobotics/sdk": "^0.30.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@viamrobotics/sdk": "^0.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
